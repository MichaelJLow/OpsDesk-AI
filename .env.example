# Database (Supabase) — Quayside / OpsDesk sandbox
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
# Anon key required for staff Auth (browser + middleware session)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role — server-only data access after login (never expose to browser)
SUPABASE_SERVICE_ROLE_KEY=

# HubSpot — client organisations & contacts (not request state)
HUBSPOT_ACCESS_TOKEN=

# Slack — #maintenance-intake, #urgent-maintenance, #approval-queue
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# Gmail / Google — shared ops inbox (plus-alias OK in sandbox)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Model provider — choose one initially (Gemini recommended for synthetic data)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Monitoring
SENTRY_DSN=

# Application
APP_URL=http://localhost:3000
AUTOMATION_API_PORT=3040
N8N_WEBHOOK_SECRET=
# Protected send: n8n Webhook URL (e.g. http://127.0.0.1:5678/webhook/opsdesk-send-reply)
N8N_SEND_WEBHOOK_URL=
# Retry failed request: n8n Webhook URL (e.g. http://127.0.0.1:5678/webhook/opsdesk-retry-request)
N8N_RETRY_WEBHOOK_URL=
# n8n Public API (VPS) — local only; never commit the real key
N8N_API_KEY=
N8N_API_BASE_URL=https://n8n.michaeljlow.com/api/v1
# Lab only — inbox "Reset demo data". Allowed automatically in NODE_ENV=development.
# Set true on a hosted demo; set false to hard-disable.
DEMO_RESET_ENABLED=
